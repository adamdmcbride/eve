    "openclaw/config/**",
    "openclaw/skills/**",
    "prompts/**"
  ],
  "behavior_owner_names": [
    "Adam"
  ],
  "owner_sensitive_patterns": [
    "*.applescript",
    "*.go",
    "*.html",
    "*.js",
    "*.json",
    "bin/eve_app_server.py",
    "docs/**",
    "eve*.py",
    "mac/*.swift",
    "*.ps1",
    "*.py",
    "*.rs",
    "*.sh",
    "*.swift",
    "*.toml",
    "web/**"
  ],
  "owner_identity_allowed_patterns": [
    "public_release.json",
    "pyproject.toml"
  ],
  "owner_identifiers": [
    "Adam"
  ],
  "owner_identifier_exemptions": {
    "bin/eve_epistemic_event_train.py": [
      "(?:torch\\.)?optim\\.AdamW",
      "adamw_differential_encoder_and_head"
    ],
    "bin/eve_lora_train.py": [
      "[\\\"']adamw?[\\\"']"
    ],
    "bin/eve_mlx_preference_train.py": [
      "adam_eps",
      "--adam-eps",
      "optim\\.AdamW",
      "\\bAdamW\\b"
    ],
    "tests/test_epistemic_event_model.py": [
      "adamw_differential_encoder_and_head"
    ],
    "tests/test_mlx_preference_train.py": [
      "adam_eps",
      "adam_epsilon"
    ],
    "tests/test_training_dataset.py": [
      "optimizer\\s*=\\s*[\\\"']adam[\\\"']"
    ]
  },
  "forbidden_declared_dependencies": [
    "arize-phoenix",
    "mlx-embeddings"
  ]
}
