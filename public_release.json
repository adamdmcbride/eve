{
  "schema_version": 1,
  "project_name": "Eve",
  "github_owner": "adamdmcbride",
  "github_repository": "eve",
  "publisher_kind": "personal",
  "release_strategy": "clean_export",
  "max_file_bytes": 8388608,
  "required_files": [
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
